# A real key is required only when the selected endpoint enforces one.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# GraphRAG may use a separate embedding endpoint.
GRAPHRAG_API_KEY=
GRAPHRAG_API_BASE=http://127.0.0.1:11434/v1
GRAPHRAG_EMBEDDING_API_BASE=http://127.0.0.1:11434/v1
GRAPHRAG_QUERY_EMBEDDING_MODEL=nomic-embed-text

# PaperQA retrieval settings used to build the supplied shared-corpus index.
PAPERQA_EMBEDDING_MODEL=nomic-embed-text
PAPERQA_LLM_MODEL=qwen2.5:3b
PAPERQA_SUMMARY_MODEL=qwen2.5:3b

# Optional only when using GEMS-RAG answer generation rather than retrieval.
VLM_API_KEY=
DASHSCOPE_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional GEMS-RAG model cache override. Defaults to ignored runs/model-cache.
MRAG_HF_HOME=
